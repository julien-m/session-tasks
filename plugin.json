{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "session-tasks",
	"version": "0.5.11",
	"description": "Persistent, editable task queue for each Codex chat.",
	"extensions": {
		"com.openai": {
			"hooks": "./hooks/hooks.json",
			"interface": {
				"displayName": "Session Tasks",
				"shortDescription": "Task list for each chat",
				"longDescription": "Add and edit tasks, attach files, and follow progress while Codex works.",
				"composerIcon": "./assets/session-tasks.png",
				"logo": "./assets/session-tasks.png",
				"category": "Productivity",
				"capabilities": ["Interactive", "Read", "Write"]
			}
		}
	}
}
